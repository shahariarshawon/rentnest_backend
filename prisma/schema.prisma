generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  UNAVAILABLE
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// =========================
// USER MODEL
// =========================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  phone        String?    @unique
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties     Property[]      @relation("LandlordProperties")
  rentalRequests RentalRequest[] @relation("TenantRentalRequests")
  reviews        Review[]        @relation("TenantReviews")

  @@index([role])
  @@index([status])
}

// =========================
// CATEGORY MODEL
// =========================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
}

// =========================
// PROPERTY MODEL
// =========================

model Property {
  id          String @id @default(uuid()) @db.Uuid
  title       String
  description String @db.Text

  address String
  area    String?
  city    String
  country String

  monthlyRent     Decimal  @db.Decimal(12, 2)
  securityDeposit Decimal? @db.Decimal(12, 2)

  bedrooms  Int  @default(0)
  bathrooms Int  @default(1)
  areaSqFt  Int?

  amenities String[] @default([])
  images    String[] @default([])

  status        PropertyStatus @default(AVAILABLE)
  availableFrom DateTime?

  categoryId String @db.Uuid
  landlordId String @db.Uuid

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  landlord User     @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalRequests RentalRequest[]
  reviews        Review[]

  @@index([city, status, monthlyRent])
  @@index([categoryId])
  @@index([landlordId])
}

// =========================
// RENTAL REQUEST MODEL
// =========================

model RentalRequest {
  id String @id @default(uuid()) @db.Uuid

  tenantId   String @db.Uuid
  propertyId String @db.Uuid

  message             String?  @db.Text
  moveInDate          DateTime
  leaseDurationMonths Int?

  status RentalRequestStatus @default(PENDING)

  landlordResponse String?   @db.Text
  decidedAt        DateTime?

  tenant User @relation("TenantRentalRequests", fields: [tenantId], references: [id], onDelete: Restrict)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  payments Payment[]
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([propertyId, status])
}

// =========================
// PAYMENT MODEL
// =========================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  rentalRequestId String @db.Uuid

  // Our unique merchant transaction reference
  transactionId String? @unique

  // SSLCommerz session identifier
  gatewaySessionId String? @unique

  // Hosted checkout URL
  gatewayUrl String?

  // Gateway validation and bank transaction references
  gatewayValidationId String? @unique
  bankTransactionId   String? @unique

  amount   Decimal @db.Decimal(12, 2)
  currency String
  method   String?

  provider PaymentProvider @default(STRIPE)
  status   PaymentStatus   @default(PENDING)

  paidAt DateTime?

  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalRequestId, status])
  @@index([provider, status])
}

// =========================
// REVIEW MODEL
// =========================

model Review {
  id String @id @default(uuid()) @db.Uuid

  tenantId        String @db.Uuid
  propertyId      String @db.Uuid
  rentalRequestId String @unique @db.Uuid

  rating  Int
  comment String? @db.Text

  tenant        User          @relation("TenantReviews", fields: [tenantId], references: [id], onDelete: Restrict)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}
