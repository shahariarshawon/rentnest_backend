PORT=5000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Seed Administrator Credentials
ADMIN_NAME="RentNest Admin"
ADMIN_EMAIL="admin@rentnest.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# JWT Secret (minimum 32 characters)
JWT_ACCESS_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"

# SSLCommerz Configuration
SSLCOMMERZ_STORE_ID="your_sandbox_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sandbox_store_password"
SSLCOMMERZ_IS_LIVE=false

# Application Public Base URL (for SSLCommerz callbacks and IPN)
API_BASE_URL="http://localhost:5000"
